{
    "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "resources/js/**/*.ts",
            "resources/js/**/*.vue"
        ]
    },
    "javascript": {
        "formatter": {
            "semicolons": "always",
            "quoteStyle": "single",
            "lineWidth": 100
        }
    },
    "linter": {
        "rules": {
            "correctness": {
                "noUnusedVariables": "error",
                "noUnusedImports": "error"
            },
            "style": {
                "useSingleVarDeclarator": "off"
            },
            "suspicious": {
                "noExplicitAny": "warn"
            }
        }
    },
    "overrides": [
        {
            "includes": [
                "./resources/js/Features/Shared/CrossSurface/Types/**"
            ],
            "formatter": {
                "enabled": false
            },
            "linter": {
                "enabled": false
            }
        }
    ]
}
