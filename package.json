{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "biome check resources/js && eslint resources/js",
        "lint:css": "stylelint \"resources/js/**/*.vue\"",
        "format": "biome check --write --unsafe resources/js",
        "generate-api-types": "npx openapi-typescript docs/openapi/openapi.yaml -o resources/js/Features/Shared/CrossSurface/Types/api.ts",
        "generate-inertia-types": "npx openapi-typescript docs/openapi/inertia/inertia.yaml -o resources/js/Features/Shared/CrossSurface/Types/inertia.ts",
        "typecheck": "npm run generate-api-types && npm run generate-inertia-types && vue-tsc --noEmit",
        "ssr:build": "vite build --ssr",
        "ssr:dev": "concurrently -k \"vite build --ssr --watch\" \"wait-on bootstrap/ssr/ssr.js && node --watch bootstrap/ssr/ssr.js\""
    },
    "dependencies": {
        "@iconify-json/devicon": "^1.2.0",
        "@iconify-json/heroicons": "^1.2.3",
        "@iconify-json/simple-icons": "^1.2.93",
        "@iconify/vue": "^5.0.1",
        "@inertiajs/vue3": "^3.6.1",
        "@tiptap/extension-code-block-lowlight": "^3.29.2",
        "@tiptap/markdown": "^3.29.2",
        "@tiptap/starter-kit": "^3.29.2",
        "@tiptap/vue-3": "^3.29.2",
        "intl-messageformat": "^11.2.13",
        "lodash-es": "^4.18.1",
        "lowlight": "^3.3.0",
        "pinia": "^4.0.2",
        "shiki": "^4.4.1",
        "vue": "^3.5.40",
        "ziggy-js": "^2.6.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^24.0.0",
        "@typescript-eslint/parser": "^8.66.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^4.1.10",
        "@vue/server-renderer": "^3.5.40",
        "@vue/test-utils": "^2.4.11",
        "axe-playwright": "^2.2.2",
        "concurrently": "^9.0.1",
        "eslint": "^10.8.0",
        "eslint-plugin-vue": "^10.10.0",
        "happy-dom": "^20.11.1",
        "html-validate": "^11.6.2",
        "laravel-vite-plugin": "^3.1",
        "openapi-typescript": "^7.13.0",
        "postcss-html": "^1.8.1",
        "stylelint": "^17.14.1",
        "stylelint-config-standard": "^40.0.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.3",
        "vite": "^8.0.0",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.9",
        "wait-on": "^8.0.5"
    }
}
