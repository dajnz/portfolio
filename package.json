{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "scripts": {
        "build": "pnpm run icons:build && vite build",
        "dev": "vite",
        "icons:build": "pnpm run icons:custom && node devops/assets/build-icon-subsets.mjs",
        "icons:custom": "node devops/assets/build-custom-icons.mjs",
        "lint": "biome check resources/js && eslint resources/js",
        "lint:css": "stylelint \"resources/js/**/*.vue\"",
        "format": "biome check --write --unsafe resources/js",
        "generate-api-types": "pnpm exec openapi-typescript docs/openapi/openapi.yaml -o resources/js/Features/Shared/CrossSurface/Types/api.ts",
        "generate-inertia-types": "pnpm exec openapi-typescript docs/openapi/inertia/inertia.yaml -o resources/js/Features/Shared/CrossSurface/Types/inertia.ts",
        "typecheck": "pnpm run generate-api-types && pnpm run generate-inertia-types && vue-tsc --noEmit",
        "ssr:build": "vite build --ssr",
        "ssr:dev": "concurrently -k \"vite build --ssr --watch\" \"wait-on bootstrap/ssr/ssr.js && node --watch bootstrap/ssr/ssr.js\"",
        "lighthouse": "lhci autorun --config=devops/lighthouse-config/lighthouserc.cjs"
    },
    "dependencies": {
        "@iconify/vue": "^5.0.1",
        "@inertiajs/core": "^3.6.1",
        "@inertiajs/vue3": "^3.6.1",
        "@tiptap/core": "^3.29.2",
        "@tiptap/extension-code-block-lowlight": "^3.29.2",
        "@tiptap/extension-image": "^3.29.2",
        "@tiptap/extension-subscript": "^3.29.2",
        "@tiptap/extension-superscript": "^3.29.2",
        "@tiptap/extension-table": "^3.29.2",
        "@tiptap/extension-table-cell": "^3.29.2",
        "@tiptap/extension-table-header": "^3.29.2",
        "@tiptap/extension-table-row": "^3.29.2",
        "@tiptap/extension-text-style": "^3.29.2",
        "@tiptap/markdown": "^3.29.2",
        "@tiptap/starter-kit": "^3.29.2",
        "@tiptap/vue-3": "^3.29.2",
        "intl-messageformat": "^11.2.13",
        "lodash-es": "^4.18.1",
        "lowlight": "^3.3.0",
        "pinia": "^4.0.2",
        "shiki": "^4.4.1",
        "vue": "^3.5.40"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@iconify-json/devicon": "^1.2.0",
        "@iconify-json/heroicons": "^1.2.3",
        "@iconify-json/lucide": "^1.2.123",
        "@iconify-json/simple-icons": "^1.2.93",
        "@iconify/tools": "^5.0.14",
        "@iconify/types": "^2.0.0",
        "@lhci/cli": "^0.15.1",
        "@playwright/test": "^1.62.1",
        "@stoplight/spectral-cli": "^6.16.3",
        "@tailwindcss/vite": "^4.0.0",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^24.0.0",
        "@typescript-eslint/parser": "^8.66.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^4.1.10",
        "@vue/server-renderer": "^3.5.40",
        "@vue/test-utils": "^2.4.11",
        "axe-core": "^4.12.1",
        "axe-playwright": "^2.2.2",
        "concurrently": "^9.0.1",
        "eslint": "^10.8.0",
        "eslint-plugin-vue": "^10.10.0",
        "happy-dom": "^20.11.1",
        "html-validate": "^11.6.2",
        "laravel-vite-plugin": "^3.1",
        "lefthook": "^2.2.2",
        "openapi-typescript": "^7.13.0",
        "postcss-html": "^1.8.1",
        "sharp": "^0.35.3",
        "stylelint": "^17.14.1",
        "stylelint-config-standard": "^40.0.0",
        "svgo": "^4.0.2",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.3",
        "vite": "^8.0.0",
        "vitest": "^4.1.10",
        "vue-component-type-helpers": "^3.3.9",
        "vue-tsc": "^3.3.9",
        "wait-on": "^8.0.5"
    }
}
