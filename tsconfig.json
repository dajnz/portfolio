{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "jsx": "preserve",
        "types": ["vite/client", "node"],
        "paths": {
            "@portfolio-public/*": ["./resources/js/Features/Portfolio/Public/*"],
            "@portfolio-admin/*": ["./resources/js/Features/Portfolio/Admin/*"],
            "@blog-public/*": ["./resources/js/Features/Blog/Public/*"],
            "@blog-admin/*": ["./resources/js/Features/Blog/Admin/*"],
            "@blog-shared/*": ["./resources/js/Features/Blog/Shared/*"],
            "@projects-public/*": ["./resources/js/Features/Projects/Public/*"],
            "@projects-admin/*": ["./resources/js/Features/Projects/Admin/*"],
            "@experience-public/*": ["./resources/js/Features/Experience/Public/*"],
            "@experience-admin/*": ["./resources/js/Features/Experience/Admin/*"],
            "@experience-shared/*": ["./resources/js/Features/Experience/Shared/*"],
            "@auth-admin/*": ["./resources/js/Features/Auth/Admin/*"],
            "@analytics-admin/*": ["./resources/js/Features/Analytics/Admin/*"],
            "@settings-admin/*": ["./resources/js/Features/Settings/Admin/*"],
            "@backup-admin/*": ["./resources/js/Features/Backup/Admin/*"],
            "@techskills-admin/*": ["./resources/js/Features/TechSkills/Admin/*"],
            "@resume-admin/*": ["./resources/js/Features/Resume/Admin/*"],
            "@shared-public/*": ["./resources/js/Features/Shared/Public/*"],
            "@shared-admin/*": ["./resources/js/Features/Shared/Admin/*"],
            "@shared-cross/*": ["./resources/js/Features/Shared/CrossSurface/*"],
            "@/*": ["./resources/js/*"]
        }
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.d.ts", "resources/js/**/*.vue"],
    "exclude": ["node_modules", "public"]
}
