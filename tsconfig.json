{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "jsx": "preserve",
        "types": [
            "vite/client",
            "node"
        ],
        "paths": {
            "@portfolio-public/*": [
                "./resources/js/Features/Portfolio/Public/Components/*"
            ],
            "@portfolio-admin/*": [
                "./resources/js/Features/Portfolio/Admin/Components/*"
            ],
            "@portfolio/*": [
                "./resources/js/Features/Portfolio/*"
            ],
            "@blog-public/*": [
                "./resources/js/Features/Blog/Public/Components/*"
            ],
            "@blog-admin/*": [
                "./resources/js/Features/Blog/Admin/Components/*"
            ],
            "@blog-shared/*": [
                "./resources/js/Features/Blog/Shared/*"
            ],
            "@projects-public/*": [
                "./resources/js/Features/Projects/Public/Components/*"
            ],
            "@projects-admin/*": [
                "./resources/js/Features/Projects/Admin/Components/*"
            ],
            "@experience-public/*": [
                "./resources/js/Features/Experience/Public/Components/*"
            ],
            "@experience-admin/*": [
                "./resources/js/Features/Experience/Admin/Components/*"
            ],
            "@experience-shared/*": [
                "./resources/js/Features/Experience/Shared/*"
            ],
            "@experience/*": [
                "./resources/js/Features/Experience/*"
            ],
            "@auth-admin/*": [
                "./resources/js/Features/Auth/Admin/Components/*"
            ],
            "@auth/*": [
                "./resources/js/Features/Auth/*"
            ],
            "@analytics-admin/*": [
                "./resources/js/Features/Analytics/Admin/Components/*"
            ],
            "@settings-admin/*": [
                "./resources/js/Features/Settings/Admin/Components/*"
            ],
            "@settings/*": [
                "./resources/js/Features/Settings/*"
            ],
            "@backup-admin/*": [
                "./resources/js/Features/Backup/Admin/Components/*"
            ],
            "@techskills-admin/*": [
                "./resources/js/Features/TechSkills/Admin/Components/*"
            ],
            "@techskills/*": [
                "./resources/js/Features/TechSkills/*"
            ],
            "@resume-admin/*": [
                "./resources/js/Features/Resume/Admin/Components/*"
            ],
            "@shared-public/*": [
                "./resources/js/Features/Shared/Public/Components/*"
            ],
            "@shared-admin/*": [
                "./resources/js/Features/Shared/Admin/Components/*"
            ],
            "@shared-cross/*": [
                "./resources/js/Features/Shared/CrossSurface/*"
            ],
            "@/*": [
                "./resources/js/*"
            ]
        }
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.d.ts",
        "resources/js/**/*.vue",
        "tests/**/*.ts",
        "vite.config.ts"
    ],
    "exclude": [
        "node_modules",
        "public"
    ]
}
