APP_NAME=Portfolio
# Dev-mode values are stored as a pair — the active line and the other mode's
# line commented. `make up` / `make up-localhost` (and the setup targets)
# activate the matching pair via devops/scripts/switch-env-mode.sh, so
# switching modes is a single command. Localhost is the default (minimal setup).
APP_URL=http://localhost:8888
# APP_URL=https://portfolio.dev.lan
APP_ENV=local
APP_DEBUG=true
# Generated on first setup (`php artisan key:generate` — part of `make setup`).
# The empty line must exist: key:generate refuses to run without it.
APP_KEY=
# Footer version shown in the admin (Version: ...). Leave empty in development
# to use the current git tag or short commit hash; production bakes the
# deployed ref into the image (devops/deploy/scripts/build-php-images.sh).
APP_VERSION=
# UID/GID the dev containers run as (build args + `user:` overrides) — must
# match your host user (`id -u` / `id -g`). `make setup` detects and exports
# them automatically; set them here when using the manual
# `docker compose` flow and rebuild the images after a change. Default 1000.
HOST_UID=1000
HOST_GID=1000
# Trusted proxies whose X-Forwarded-Proto/X-Forwarded-For headers Laravel
# accepts (comma-separated IPs or `*`). TLS dev mode runs behind Traefik so
# activates `*`; localhost mode and production (TLS terminated by nginx
# itself) leave it empty — spoofed headers are then ignored. Switched
# together with `APP_URL` by the mode entry points.
TRUSTED_PROXIES=
# TRUSTED_PROXIES=*
PORTFOLIO_DEV_MODE=localhost
# PORTFOLIO_DEV_MODE=tls
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_BINDING_ENABLED=true
# Set to true when the site is served over HTTPS (production sets it there).
# SESSION_SECURE_COOKIE=true
# Admin remember-me lifetime in minutes (default 30 days).
# AUTH_REMEMBER_LIFETIME_MINUTES=43200
QUEUE_CONNECTION=redis
INERTIA_SSR_URL=http://dev:3000
LETSENCRYPT_EMAIL=
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=portfolio
DB_USERNAME=sail
DB_PASSWORD=password

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

RUSTFS_ACCESS_KEY=sail
RUSTFS_SECRET_KEY=password
RUSTFS_BUCKET=portfolio
RUSTFS_BACKUPS_ACCESS_KEY=sail_backups
RUSTFS_BACKUPS_SECRET_KEY=password_backups
RUSTFS_BACKUPS_BUCKET=backups
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_USE_PATH_STYLE_ENDPOINT=true
ANALYTICS_IP_HASH_KEY=
NOT_BOT_USER_AGENT_PATTERN=
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_KEY=

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_API_ENDPOINT=
MAIL_API_TOKEN=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=${APP_URL}/admin/login/github/callback
