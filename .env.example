APP_NAME=Portfolio
APP_URL=https://portfolio.dev.lan
APP_ENV=local
APP_DEBUG=true
PORTFOLIO_DEV_MODE=tls
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
INERTIA_SSR_URL=http://dev:3000
LETSENCRYPT_EMAIL=
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=portfolio
DB_USERNAME=sail
DB_PASSWORD=password

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

RUSTFS_ACCESS_KEY=sail
RUSTFS_SECRET_KEY=password
RUSTFS_BUCKET=portfolio
RUSTFS_BACKUPS_ACCESS_KEY=sail_backups
RUSTFS_BACKUPS_SECRET_KEY=password_backups
RUSTFS_BACKUPS_BUCKET=backups
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_USE_PATH_STYLE_ENDPOINT=true
ANALYTICS_IP_HASH_KEY=
NOT_BOT_USER_AGENT_PATTERN=
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_KEY=

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_API_ENDPOINT=
MAIL_API_TOKEN=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=${APP_URL}/admin/login/github/callback
