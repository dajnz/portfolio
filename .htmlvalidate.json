{
    "extends": [
        "html-validate:recommended"
    ],
    "rules": {
        "no-unknown-attributes": "off",
        "no-inline-style": "off",
        "no-trailing-whitespace": "off",
        "attribute-empty-style": "off",
        "element-permitted-content": "error",
        "attribute-boolean-style": [
            "error",
            {
                "style": "empty"
            }
        ]
    }
}
